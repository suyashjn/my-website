# Next.js Build Outputs & Cache (Massive text files that waste context)
.next/
out/
build/
dist/

# Dependencies & Package Managers
node_modules/
.pnpm-store/
.yarn/

# Environmental & Secret Files (Security & Context Safety)
.env
.env.*
!.env.example
*.local

# Heavy Static Assets (Binary data that the LLM cannot read)
public/images/
public/assets/
public/videos/
public/fonts/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp
*.mp4
*.webm
*.pdf

# Typescript & Build Logs
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, OS, and Configuration Noise
.idea/
.vscode/
*.suo
*.ntvs*
